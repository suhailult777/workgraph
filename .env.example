# Copy to .env and fill values locally. Never commit a filled .env.
# Names only. No secret value belongs in the repository.

# Live server assistant (OpenRouter free models only)
OPENROUTER_API_KEY=
# Default free list is in backend/assistant.py; add a comma list to override.
OPENROUTER_FREE_MODELS=
ASSISTANT_IP_DAILY_CAP=20
ASSISTANT_GLOBAL_DAILY_CAP=300

# PayPal Orders v2 sandbox only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MOCK=0

# Durable snapshot storage (Vercel Blob in production)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_PATH=workgraph/workgraph.rl

# production refuses the local demo fallback
WORKGRAPH_ENV=production
