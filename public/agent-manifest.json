{
  "brand": "WorkGraph Assistant",
  "networks": [
    {
      "name": "workgraph",
      "front_man": "workgraph_coordinator",
      "hocon": "./workgraph.network.json",
      "description": "Trace invoice decline paths, find paid work by skill, draft a plan, and accept or pay only after an on-screen confirmation.",
      "tags": [
        "agentified-website",
        "relate-hackathon"
      ],
      "sample_queries": [
        "Which milestones are blocked until WG-1002 is paid?",
        "Who has been paid for design-system work before?",
        "Show the projects and their milestone status.",
        "Draft and accept a plan for a new brand project.",
        "Record the sample payment for WG-1002.",
        "Record a real card payment for the design system."
      ]
    }
  ],
  "llm_router": {
    "base_url": "/api/assistant",
    "mock": false,
    "byok_router": "https://openrouter.ai/api/v1"
  },
  "allowed_peers": [],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Phase 1 milestone 2: browser reads and a local draft only."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "workgraph",
    "front_man": "workgraph_coordinator",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#245c4f"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "workgraph",
        "front_man": "workgraph_coordinator",
        "aliases": [
          "workgraph",
          "workgraph_coordinator"
        ],
        "url": "workgraph"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": true,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "agentTools": [
      "get_graph_state",
      "search_similar_work",
      "get_decline_path",
      "propose_plan",
      "fill_draft",
      "accept_plan",
      "record_payment"
    ]
  }
}
